{
  "name": "christopher-scott-io",
  "version": "3.0.0",
  "private": true,
  "description": "Christopher Scott — Cybersecurity & IT Professional",
  "scripts": {
    "start": "node server.js",
    "check": "node --check app.js && node --check config.js && node --check content.js && node --check server.js && node --check scripts/browser-check.js && node scripts/validate-content.js",
    "check:browser": "node scripts/browser-check.js",
    "blog:build": "node scripts/build-blog.mjs",
    "blog:import": "node scripts/import-post.mjs",
    "test:blog": "node scripts/test-blog.mjs",
    "prestart": "npm run blog:build",
    "blog:editor": "node server.js --editor",
    "preblog:editor": "npm run blog:build",
    "build": "node scripts/build-site.mjs",
    "preview:public": "node server.js --dist"
  },
  "devDependencies": {
    "marked": "^18.1.1",
    "sanitize-html": "^2.18.1"
  }
}
